{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/simple-api-client/schema/item.schema.json",
  "title": "Item",
  "type": "object",
  "required": [
    "id",
    "name"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "pattern": "^item-[0-9]+$"
    }
  },
  "additionalProperties": false
}
